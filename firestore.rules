rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidReactionMap(reactions) {
      return reactions is map
        && reactions.keys().hasOnly(['fire', 'laugh', 'clap', 'chicken'])
        && (!('fire' in reactions) || (reactions.fire is int && reactions.fire >= 0 && reactions.fire <= 9999))
        && (!('laugh' in reactions) || (reactions.laugh is int && reactions.laugh >= 0 && reactions.laugh <= 9999))
        && (!('clap' in reactions) || (reactions.clap is int && reactions.clap >= 0 && reactions.clap <= 9999))
        && (!('chicken' in reactions) || (reactions.chicken is int && reactions.chicken >= 0 && reactions.chicken <= 9999));
    }

    function isPublicReactionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && isValidReactionMap(request.resource.data.reactions);
    }

    match /palpites/{palpiteId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null || isPublicReactionUpdate();
      allow delete: if request.auth != null;
    }

    match /resultados/{resultadoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
